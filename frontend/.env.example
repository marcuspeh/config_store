# Default API base URL baked into the Vite build.
#
# Resolution order:
#   1. import.meta.env.VITE_API_URL — set by .env / .env.local / shell /
#      docker build-arg (see frontend/Dockerfile).
#   2. Fallback to the relative "/api" path, which works in dev via the
#      Vite proxy in vite.config.ts and in prod via the nginx proxy.
VITE_API_URL=/api
