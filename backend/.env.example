MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=default
MONGO_DB=config_store
MONGO_COLLECTION=configs
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=config_store
MYSQL_PASSWORD=config_store_password
MYSQL_DATABASE=config_store
SYNC_INTERVAL=60

# Logging SDK — Kafka producer pointed at the logging_system broker.
# `logging-kafka` is reachable on the shared `logging-net` docker network.
LOG_KAFKA_BROKERS=logging-kafka:9092
LOG_TOPIC=logs
LOG_PROJECT=config-store
LOG_ASYNC_CAPACITY=4096
LOG_FLUSH_INTERVAL=1.0
LOG_LEVEL=INFO
# Set to 1 to disable the SDK (e.g. local dev without Kafka on PATH).
LOG_DISABLED=0